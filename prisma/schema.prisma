generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tool {
  id              String   @id // slug, e.g. "opencode"
  name            String
  repo            String // "owner/repo"
  desc            String
  replaces        String
  cat             String // CATEGORIES id
  stars           Int      @default(0)
  platforms       String   @default("web") // CSV: "web,mac,win"
  selfHosted      Boolean  @default(false)
  sourceAvailable Boolean  @default(false)
  weeklyGain      Int?
  createdAt       DateTime @default(now())
  emoji           String   @default("🧩")
  glyph           String? // 1-3 letter fallback icon
  status          String   @default("curated") // "curated" | "community" | "pending"
  submitter       String? // display name / email of community submitter
  featured        Boolean  @default(false) // editorial pick — toggled by moderators
  logoUrl         String? // small square branding image (submitted or curated)
  screenshotUrl   String? // product screenshot shown on the detail page
  headerUrl       String? // wide banner shown at the top of the detail page
  toolVotes       Vote[]

  @@index([cat])
  @@index([status])
  @@index([weeklyGain])
}

model Vote {
  id        String   @id @default(cuid())
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  voter     String // anonymous client token (localStorage)
  createdAt DateTime @default(now())

  @@unique([toolId, voter])
  @@index([voter])
}

// Community "wanted alternative" request board.
// id is the slug of the target software so duplicate requests resolve to the
// same row — a duplicate becomes a WantVote ("the strongest needs rise").
model Want {
  id        String   @id // slug of the target, e.g. "notion"
  target    String // display name of the software to replace
  note      String? // extra context from the requester
  status    String   @default("open") // "open" | "progress" | "fulfilled"
  requester String? // display name; null = anonymous visitor
  dupes     Int      @default(0) // duplicate requests merged into this one
  baseVotes Int      @default(0) // seeded/editorial votes; real total = baseVotes + wantVotes count
  connected String   @default("") // CSV of Tool ids linked when a request is fulfilled
  createdAt DateTime @default(now())
  wantVotes WantVote[]

  @@index([status])
}

model WantVote {
  id        String   @id @default(cuid())
  wantId    String
  want      Want     @relation(fields: [wantId], references: [id], onDelete: Cascade)
  voter     String // anonymous client token (localStorage)
  createdAt DateTime @default(now())

  @@unique([wantId, voter])
  @@index([voter])
}

// Blog / editorial content managed from the admin CMS.
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique // derived from the title, immutable after create
  title       String
  excerpt     String // short summary shown on cards
  content     String // markdown body
  author      String    @default("AIStore Editors")
  tags        String    @default("") // CSV, e.g. "changelog,featured"
  coverEmoji  String    @default("📝")
  status      String    @default("draft") // "draft" | "published"
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

// House ads / sponsored slots — small, non-intrusive cards shown on the
// public site. Stats (impressions/clicks) feed the admin Ads module.
model Ad {
  id          String   @id @default(cuid())
  name        String // internal label, e.g. "Acme Cloud — spring"
  headline    String // card title, ≤60 chars
  body        String // one-line copy, ≤120 chars
  ctaLabel    String @default("Learn more")
  ctaUrl      String // destination (opens in a new tab)
  imageUrl    String? // optional small square image; emoji fallback
  emoji       String   @default("✨")
  placement   String   @default("browse") // "browse" | "blog" | "wanted"
  active      Boolean  @default(false)
  weight      Int      @default(1) // higher = picked more often in rotation
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([placement, active])
}

// Anonymous, cookie-less page analytics for the admin Overview.
// One row per SPA view change; `session` is a random localStorage token.
model PageView {
  id        String   @id @default(cuid())
  path      String // SPA view id, e.g. "discover" / "tool" / "blog"
  session   String // anonymous visitor token (not a fingerprint)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

// Rate-limiting hits, one row per counted request. Sliding-window counters
// live in the database (not process memory) so throttling and admin
// lockouts survive deploys and work across instances. Rows are pruned
// once they age past every policy window.
model RateEvent {
  id        String   @id @default(cuid())
  bucket    String // surface, e.g. "admin-auth" / "tool-vote"
  ip        String // from X-Forwarded-For (set by the Caddy proxy)
  createdAt DateTime @default(now())

  @@index([bucket, ip, createdAt])
}
