# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon in production). The direct (non-pooler)
# endpoint is required — the app uses Prisma interactive transactions.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.aws.neon.tech/neondb?sslmode=require

# Moderator token for the admin console (Authorization: Bearer <token>).
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=replace-me

# Optional: upload storage dir (default: public/uploads, served at /uploads/<name>).
# Override when tests or a different storage layout need it.
# UPLOAD_DIR=/somewhere/writable/uploads

# Optional: durable upload storage. Default "local" keeps uploads under
# public/uploads (ephemeral across redeploys). "s3" stores objects in any
# S3-compatible bucket (R2, MinIO, B2, AWS…) so uploads survive deployments.
# UPLOAD_STORAGE=s3
# UPLOAD_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com   # origin only
# UPLOAD_S3_BUCKET=aistore-media
# UPLOAD_S3_REGION=auto            # "auto" works for R2; AWS wants its region
# UPLOAD_S3_ACCESS_KEY_ID=...      # a key with write access to the bucket
# UPLOAD_S3_SECRET_ACCESS_KEY=...
# UPLOAD_S3_SESSION_TOKEN=...      # only for temporary credentials
# UPLOAD_S3_KEY_PREFIX=uploads/    # key prefix inside the bucket
# UPLOADS_PUBLIC_BASE_URL=https://cdn.example.com
#   ↑ optional: serve uploads straight from a CDN/bucket URL instead of
#     proxying them through GET /api/uploads/<name> (which is what the app
#     returns when this is unset). Either way the URL stored in the DB was
#     validated at write time — switching adapters later does not rewrite
#     previously stored URLs.
