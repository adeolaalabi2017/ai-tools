generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tool {
  id              String   @id // slug, e.g. "opencode"
  name            String
  repo            String // "owner/repo"
  desc            String
  replaces        String
  cat             String // CATEGORIES id
  stars           Int      @default(0)
  platforms       String   @default("web") // CSV: "web,mac,win"
  selfHosted      Boolean  @default(false)
  sourceAvailable Boolean  @default(false)
  weeklyGain      Int?
  createdAt       DateTime @default(now())
  emoji           String   @default("🧩")
  glyph           String? // 1-3 letter fallback icon
  status          String   @default("curated") // "curated" | "community" | "pending"
  submitter       String? // display name / email of community submitter
  featured        Boolean  @default(false) // editorial pick — toggled by moderators
  toolVotes       Vote[]

  @@index([cat])
  @@index([status])
  @@index([weeklyGain])
}

model Vote {
  id        String   @id @default(cuid())
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  voter     String // anonymous client token (localStorage)
  createdAt DateTime @default(now())

  @@unique([toolId, voter])
  @@index([voter])
}
